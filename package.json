{
  "name": "budget-beaver",
  "version": "1.0.0",
  "description": "Budget Beaver - household finance tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server/index.js",
    "dev:client": "npm --prefix src/client run dev",
    "build:client": "npm --prefix src/client run build",
    "start": "node src/server/index.js",
    "install:client": "npm --prefix src/client install",
    "test:server": "vitest run --root src/server",
    "test:client": "npm --prefix src/client run test",
    "test": "npm run test:server && npm run test:client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vitest": "^2.1.8"
  }
}
